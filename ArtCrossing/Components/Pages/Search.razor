@page "/"
@rendermode InteractiveServer
@inject IEnumerable<IArtworkSource> ArtworkSources

<PageTitle>Art Crossing</PageTitle>

<h1>Art Crossing</h1>

<form @onsubmit="SearchAsync">
    <input type="search" @bind="query" placeholder="Search artworks" aria-label="Search artworks"/>
    <button type="submit" disabled="@isSearching">Search</button>
</form>

@foreach (string error in errors)
{
    <p>@error</p>
}

@if (isSearching)
{
    <p><em>Searching...</em></p>
}
else if (results is not null)
{
    if (results.Count == 0)
    {
        <p>No artworks found.</p>
    }
    else
    {
        <p>@results.Count artworks found.</p>
        <div class="results-grid">
            @foreach (Artwork artwork in results)
            {
                <article class="artwork-card" @key="artwork.Key">
                    <div class="artwork-image">
                        @if (string.IsNullOrEmpty(artwork.ImageUrl) || failedImages.Contains(artwork.Key))
                        {
                            <span class="no-image">Image not available</span>
                        }
                        else
                        {
                            <img src="@artwork.ImageUrl" alt="@artwork.AltText" loading="lazy"
                                 @onerror="() => failedImages.Add(artwork.Key)"/>
                        }
                    </div>

                    <div class="artwork-body">
                        <div>
                            <h2 class="artwork-title">@artwork.Title</h2>
                            <p class="artwork-artist">@artwork.Artist, @(artwork.CompletionYear?.ToString() ?? "Unknown year")</p>
                            <p class="artwork-medium" title="@artwork.Medium">@artwork.Medium</p>
                        </div>

                        <div class="artwork-footer">
                            <span class="museum-badge">@artwork.MuseumName</span>
                            <a class="artwork-link" href="@artwork.WebUrl" target="_blank" rel="noopener noreferrer">View on the museum website</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
}

@code {
    private string query = string.Empty;
    private List<Artwork>? results;
    private List<string> errors = [];
    private HashSet<string> failedImages = [];
    private bool isSearching;

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return;
        }

        isSearching = true;
        errors = [];
        failedImages = [];
        results = null;

        IReadOnlyList<Artwork>[] resultsPerSource = await Task.WhenAll(ArtworkSources.Select(SearchSourceAsync));

        results = resultsPerSource.SelectMany(artworks => artworks).ToList();
        isSearching = false;
    }

    private async Task<IReadOnlyList<Artwork>> SearchSourceAsync(IArtworkSource source)
    {
        try
        {
            return await source.SearchAsync(query);
        }
        catch (ArtworkSourceException ex)
        {
            errors.Add(ex.Message);
            return [];
        }
    }
}
